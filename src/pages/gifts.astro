---
import { Picture } from 'astro:assets';
import Shell from '../layouts/Shell.astro';
import Divider from '../components/Divider.astro';
import Tile from '../components/Tile.astro';
import { photo } from '../lib/photos.js';
import { all, shop, money } from '../data/shop.js';

const gifts = all.filter((p) => p.kind === 'Gifts');
---
<Shell
  title="Gifts | Hollyhock"
  description="Gifts from Hollyhock in Santa Barbara: candles, stoneware vases, handwritten cards, chocolates, dried bunches and succulents, sent alone or with flowers."
>
  <div class="page stack">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Gifts</span></nav>
    <header class="collage-head">
      <div class="collage-text">
        <h1 class="opener-title">Gifts</h1>
        <p class="lede">Six things that keep longer than flowers, made within an hour of the shop.</p>
        <dl class="facts">
          <div><dt>Wrapped</dt><dd>Plain paper and twine</dd></div>
          <div><dt>Card</dt><dd>Written by hand, no charge</dd></div>
          <div><dt>Delivery</dt><dd>Same day if you order by noon</dd></div>
        </dl>
        <a class="button" href="#shelf">See the shelf</a>
      </div>
      <div class="collage">
        <Picture src={photo('gift-candle')} formats={['avif', 'webp']} widths={[400, 700, 1000]} sizes="(min-width: 960px) 28vw, 60vw" alt="A blush pillar candle beside a bunch of small pink flowers." style="object-position: 70% 60%" loading="eager" fetchpriority="high" />
        <Picture src={photo('gift-vase')} formats={['avif', 'webp']} widths={[300, 500, 700]} sizes="(min-width: 960px) 18vw, 40vw" alt="A cream stoneware vase of yellow and white flowers." loading="eager" />
        <Picture src={photo('gift-chocolates')} formats={['avif', 'webp']} widths={[300, 500, 700]} sizes="(min-width: 960px) 18vw, 40vw" alt="An open box of assorted chocolates." loading="eager" />
      </div>
    </header>

    <Divider />

    <section id="shelf" aria-labelledby="shelf-title">
      <div class="sec-head">
        <h2 class="display" id="shelf-title">On the shelf</h2>
        <p>Made in small numbers. When one is gone we wait for the next batch.</p>
      </div>
      <div class="grid grid-big">
        {gifts.map((item) => <Tile item={item} />)}
      </div>
    </section>

    <section class="band-mist steps" aria-labelledby="how-title">
      <h2 class="display" id="how-title">Sending a gift</h2>
      <ol>
        <li><h3>Choose it</h3><p>Add a gift to the order slip, with flowers or without. Or call and tell us what you want to spend.</p></li>
        <li><h3>Give us the words</h3><p>We write your message on a card by hand, exactly as you give it to us. No charge.</p></li>
        <li><h3>We wrap it</h3><p>Plain paper and twine. No cellophane, no ribbon printed with our name.</p></li>
        <li><h3>We deliver it</h3><p>Same day if you order by noon, Tuesday to Sunday. $15 within Santa Barbara.</p></li>
      </ol>
    </section>

    <section class="closer" aria-labelledby="closer-title">
      <h2 class="display" id="closer-title">Not sure what to send?</h2>
      <a class="button" href={`tel:${shop.tel}`}>Call {shop.phone}</a>
    </section>
  </div>
</Shell>
