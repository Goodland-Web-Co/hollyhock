---
import { Picture } from 'astro:assets';
import Shell from '../layouts/Shell.astro';
import Divider from '../components/Divider.astro';
import { photo } from '../lib/photos.js';
import { shop } from '../data/shop.js';

const write = `mailto:${shop.email}?subject=${encodeURIComponent('Custom order')}`;
const kinds = [
  { name: 'Sympathy', price: 'From $90', text: 'Sprays, wreaths and flowers for the house. Two days\' notice. We deliver to the home or the service, and we can write the card.' },
  { name: 'Weekly flowers', price: 'From $55 a week', text: 'For a home, a restaurant or a front desk. Changed every week, on the day you choose. Stop or pause with a telephone call.' },
  { name: 'In quantity', price: 'Ask for a price', text: 'Forty stems of one flower in one color, or buckets for arranging yourself. Three days\' notice.' },
  { name: 'Something else', price: 'Ask', text: 'A crown for a quinceañera. Flowers for a photograph. A single stem sent every Friday. We will tell you plainly whether we can do it and what it costs.' },
];
---
<Shell
  title="Custom Orders | Hollyhock"
  description="Custom flower orders from Hollyhock in Santa Barbara: sympathy flowers, weekly flowers for a home or business, and anything not on the list."
>
  <div class="page stack">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><span>Custom Orders</span></nav>
    <section class="split2">
      <div>
        <h1 class="opener-title">Custom orders</h1>
        <p class="lede">If it is not on the list, tell us what it is for and what you want to spend. You approve it before we cut anything.</p>
<Divider wide />
        <div class="acc">
          {kinds.map((k, i) => (
            <details open={i === 0}>
              <summary><span class="acc-name">{k.name}</span><span class="eyebrow">{k.price}</span></summary>
              <p>{k.text}</p>
            </details>
          ))}
        </div>
        <a class="button" href={write}>Write to the shop</a>
      </div>
      <Picture class="split2-photo" src={photo('arranging')} formats={['avif', 'webp']} widths={[480, 768, 1100]} sizes="(min-width: 960px) 34vw, 100vw" alt="Hands arranging pink and white flowers in a clear glass vase." loading="eager" fetchpriority="high" />
    </section>

    <section class="closer" aria-labelledby="closer-title">
      <h2 class="display" id="closer-title">Or tell us on the telephone.</h2>
      <a class="button" href={`tel:${shop.tel}`}>Call {shop.phone}</a>
    </section>
  </div>
</Shell>
